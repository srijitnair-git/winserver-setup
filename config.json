  "GPO": {
    "DriveMapGpoName": "Domech - Drive Mappings",
    "BrandingGpoName": "Domech - Branding",
    "EnsureServicesGpoName": "Domech - Ensure Services",
    "RestrictCDriveGpoName": "Domech - Restrict C Drive"
  },
  "Branding": {
    "SplashPng": "C:\\01_matrix\\Assets\\LoginSplash.png",
    "SplashFontTtf": "C:\\01_matrix\\Assets\\Fonts\\Geist-Bold.ttf",
    "WallpaperPng": "C:\\01_matrix\\Assets\\Wallpaper.png",
    "LockScreenPng": "C:\\01_matrix\\Assets\\LockScreen.png",
    "_comment": "LoginSplash.png is the background only - the employee's real name is drawn on top live at logon by Show-LoginSplash.ps1, using SplashFontTtf so it doesn't need the font installed on the workstation."
  },
  "ShadowCopy": {
    "MaxStoragePercent": 10,
    "Schedule": ["07:00", "12:00"]
  },
  "Personal": {
    "DriveLetter": "P",
    "FolderName": "Personal",
    "_comment": "Each user gets D:\\Domech\\Personal\\<username>, shared as <username>$, mapped to P: for that user only. Desktop/Documents/Downloads/Pictures redirect there automatically."
  },
  "RustDesk": {
    "RendezvousServer": ""
  },
  "RequiredServices": ["WinRM", "Spooler", "RustDesk Service"],
  "WingetApps": [
    "7zip.7zip",
    "RustDesk.RustDesk",
    "SumatraPDF.SumatraPDF",
    "FastStone.FastStoneImageViewer",
    "VideoLAN.VLC",
    "Google.Chrome",
    "Microsoft.PowerShell"
  ]
