  "Network": {
    "SubnetPrefixLength": 24,
    "Gateway": "192.168.0.1",
    "DnsServer": "192.168.0.10",
    "_comment": "DnsServer should be the DF.local DC's own static IP. WorkstationIPs below assigns one static IP per machine - add every hostname from Workstations here.",
